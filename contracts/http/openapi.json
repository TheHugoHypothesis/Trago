          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "BRL"
            ]
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "ORGANIZATION"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "displayName"
        ]
      },
      "TripInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 2
          },
          "destination": {
            "type": "string",
            "minLength": 2
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "availableWeightGrams": {
            "type": "integer",
            "minimum": 1
          },
          "pricePerKg": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "origin",
          "destination",
          "departureDate",
          "timeZone",
          "availableWeightGrams",
          "pricePerKg"
        ]
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "estimatedWeightGrams": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "description",
          "price",
          "estimatedWeightGrams"
        ]
      },
      "RequestInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        },
        "required": [
          "accountId",
          "tripId",
          "product"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "Trip": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 2
          },
          "destination": {
            "type": "string",
            "minLength": 2
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "availableWeightGrams": {
            "type": "integer",
            "minimum": 1
          },
          "pricePerKg": {
            "$ref": "#/components/schemas/Money"
          },
          "id": {
            "type": "string"
          },
          "travelerName": {
            "type": "string"
          },
          "isDemo": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "origin",
          "destination",
          "departureDate",
          "timeZone",
          "availableWeightGrams",
          "pricePerKg",
          "id",
          "travelerName",
          "isDemo"
        ]
      },
      "PurchaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "tripId",
          "product",
          "status",
          "createdAt"
        ]
      }
    }
  }
}
