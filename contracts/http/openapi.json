        "description": "Lists requests associated with trips owned by the authenticated traveler.",
        "responses": {
          "200": {
            "description": "Incoming requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PurchaseRequest"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/purchase-requests/{id}/accept": {
      "post": {
        "operationId": "acceptPurchaseRequest",
        "description": "Atomically accepts a pending request and reserves its integer weight on the trip. Repeating the same acceptance is safe and does not reserve twice. No payment or custody is confirmed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase request visible to the authorized buyer account or trip owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseRequest"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request not found or trip not owned by requester",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting decision or unavailable trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient remaining capacity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/purchase-requests/{id}/reject": {
      "post": {
        "operationId": "rejectPurchaseRequest",
        "description": "Rejects a pending request without consuming capacity. Repeating the same rejection is safe.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase request visible to the authorized buyer account or trip owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseRequest"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request not found or trip not owned by requester",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting decision or unavailable trip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient remaining capacity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256 access token from /v1/auth/register or /v1/auth/login. Demo dev:* tokens require explicit development/test mode and are not accepted by /v1/auth/me or /v1/auth/logout."
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "BRL"
            ]
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "ORGANIZATION"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "taxId": {
            "type": "string"
          },
          "accessRole": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "displayName"
        ]
      },
      "OrganizationAccountInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "required": [
          "displayName"
        ]
      },
      "OrganizationMemberInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "TripInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "destination": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "availableWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Total capacity offered when creating or editing a trip, in integer grams."
          },
          "pricePerKg": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "origin",
          "destination",
          "departureDate",
          "timeZone",
          "availableWeightGrams",
          "pricePerKg"
        ]
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "estimatedWeightGrams": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "description",
          "price",
          "estimatedWeightGrams"
        ]
      },
      "RequestInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        },
        "required": [
          "accountId",
          "tripId",
          "product"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
      "Trip": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 2
          },
          "destination": {
            "type": "string",
            "minLength": 2
          },
          "departureDate": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "availableWeightGrams": {
            "type": "integer",
            "minimum": 0,
            "description": "Remaining capacity in integer grams: total minus reserved."
          },
          "pricePerKg": {
            "$ref": "#/components/schemas/Money"
          },
          "id": {
            "type": "string"
          },
          "travelerName": {
            "type": "string"
          },
          "isDemo": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "totalWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Total capacity offered for the trip, in integer grams."
          },
          "reservedWeightGrams": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Capacity atomically reserved by accepted requests, in integer grams."
          }
        },
        "required": [
          "origin",
          "destination",
          "departureDate",
          "timeZone",
          "availableWeightGrams",
          "pricePerKg",
          "id",
          "travelerName",
          "isDemo",
          "status",
          "totalWeightGrams",
          "reservedWeightGrams"
        ]
      },
      "PurchaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string"
          },
          "tripId": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED"
            ],
            "description": "Traveler decision state. ACCEPTED reserves capacity atomically but does not confirm payment or custody."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "tripCapacity": {
            "$ref": "#/components/schemas/TripCapacity",
            "description": "Current confirmed capacity returned with a traveler decision."
          }
        },
        "required": [
          "id",
          "accountId",
          "tripId",
          "product",
          "status",
          "createdAt"
        ]
      },
      "RegisterInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true,
            "description": "No trimming or normalization. At least 12 characters."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "displayName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "createdAt"
        ]
      },
      "AuthSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "TripCapacity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "totalWeightGrams": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "reservedWeightGrams": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "availableWeightGrams": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "totalWeightGrams",
          "reservedWeightGrams",
          "availableWeightGrams"
        ]
      }
    }
  }
}
