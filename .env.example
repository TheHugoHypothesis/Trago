# Local example. Export these variables before starting Node.
# For Render and Supabase, see docs/CLOUD_DEPLOYMENT.md.
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=0
TRAGO_DEMO_AUTH=false

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_TLS=false
# Production requires TLS and a dedicated existing schema.
DATABASE_TLS_CA=
DATABASE_TLS_CA_FILE=
DATABASE_SCHEMA=

# Generate a random secret of at least 32 bytes outside Git.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=900
AUTH_MAX_CONCURRENT=2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
