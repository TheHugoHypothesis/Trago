{
  "version": 1,
  "tasks": [
    {
      "id": "T00-toolchain",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Preparar manifests, versões fixas e comandos reais da stack local",
      "role": "toolchain",
      "agent": "codex",
      "dependencies": [],
      "allowed_paths": [
        "package.json",
        "package-lock.json",
        ".nvmrc",
        ".npmrc",
        "tsconfig.base.json",
        "compose.yaml",
        ".env.example",
        "Makefile",
        "scripts/verify-product.py",
        ".github/workflows/",
        "apps/api/package.json",
        "apps/web/package.json",
        "packages/api-client-ts/package.json"
      ],
      "expected_outputs": [
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "compose.yaml",
        "scripts/verify-product.py",
        "apps/api/package.json",
        "apps/web/package.json",
        "packages/api-client-ts/package.json"
      ],
      "acceptance_criteria": [
        "Preservar make verify-foundation e o controlador; toolchain não equivale a produto pronto",
        "Fixar dependências compatíveis Next/Nest/Fastify/OpenAPI/TS e lockfile; scripts verify de cada workspace",
        "Não conectar provedores externos; banco local isolado e configuração sem segredos",
        "Scripts de produto falham se componente obrigatório ainda não implementado; sem testes vazios para simular sucesso"
      ],
      "verification_commands": [
        [
          "npm",
          "run",
          "verify:toolchain"
        ],
        [
          "make",
          "verify-foundation"
        ]
      ],
      "risk": "medium",
      "max_retries": 1,
      "timeout_seconds": 1800,
      "approved": true
    },
    {
      "id": "T01-contract",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Definir OpenAPI, fixtures PF/PJ e geração dos clientes TS/Kotlin",
      "role": "contracts",
      "agent": "codex",
      "dependencies": [
        "T00-toolchain"
      ],
      "allowed_paths": [
        "contracts/",
        "packages/api-client-ts/src/",
        "apps/android/core/api/"
      ],
      "expected_outputs": [
        "contracts/http/openapi.yaml",
        "contracts/fixtures/requests.json",
        "packages/api-client-ts/src/index.ts"
      ],
      "acceptance_criteria": [
        "Cobrir AC-01 a AC-05 no contrato e fixtures; definir auth, limites, idempotência e erros",
        "Cliente gerado reproduzível; preservar manifests/lockfile de T00",
        "Nada de tributo/escrow simulado como operação real"
      ],
      "verification_commands": [
        [
          "npm",
          "run",
          "verify:contracts"
        ]
      ],
      "risk": "high",
      "max_retries": 1,
      "timeout_seconds": 1800,
      "approved": true
    },
    {
      "id": "T02-api",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Implementar viagem e rascunho privado PF/PJ em PostgreSQL com TDD",
      "role": "backend",
      "agent": "codex",
      "dependencies": [
        "T01-contract"
      ],
      "allowed_paths": [
        "apps/api/src/",
        "apps/api/test/",
        "apps/api/tsconfig.json"
      ],
      "expected_outputs": [
        "apps/api/src/main.ts",
        "apps/api/test/request-authorization.spec.ts"
      ],
      "acceptance_criteria": [
        "AC-01 a AC-05; negar acesso entre contas e após revogação de membership",
        "Persistência PostgreSQL real, migração e idempotência; red/green demonstrados",
        "Sem fetch de link de produto, pagamentos ou declaração aduaneira"
      ],
      "verification_commands": [
        [
          "npm",
          "run",
          "verify",
          "--workspace",
          "@trago/api"
        ]
      ],
      "risk": "high",
      "max_retries": 1,
      "timeout_seconds": 1800,
      "approved": true
    },
    {
      "id": "T03-web",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Implementar busca e solicitação privada PF/PJ no Web",
      "role": "web",
      "agent": "agy",
      "dependencies": [
        "T01-contract"
      ],
      "allowed_paths": [
        "apps/web/app/",
        "apps/web/components/",
        "apps/web/lib/",
        "apps/web/tests/",
        "apps/web/tsconfig.json",
        "apps/web/next.config.ts",
        "apps/web/next-env.d.ts"
      ],
      "expected_outputs": [
        "apps/web/app/page.tsx",
        "apps/web/tests/request-flow.spec.ts"
      ],
      "acceptance_criteria": [
        "Usar contrato/cliente gerado; loading/vazio/erro e seleção PF/PJ",
        "Não implementar regras monetárias ou identidade produtiva no cliente",
        "Limpar dados privados na troca de contexto; acessibilidade e layout responsivo"
      ],
      "verification_commands": [
        [
          "npm",
          "run",
          "verify",
          "--workspace",
          "@trago/web"
        ]
      ],
      "risk": "medium",
      "max_retries": 1,
      "timeout_seconds": 1800,
      "approved": true
    },
    {
      "id": "T04-android",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Implementar o mesmo fluxo PF/PJ em Kotlin/Compose",
      "role": "android",
      "agent": "pi",
      "dependencies": [
        "T01-contract"
      ],
      "allowed_paths": [
        "apps/android/"
      ],
      "expected_outputs": [
        "apps/android/gradlew",
        "apps/android/settings.gradle.kts",
        "apps/android/app/build.gradle.kts"
      ],
      "acceptance_criteria": [
        "Compose/ViewModel/data e cliente gerado de T01, sem duplicar regras de negócio",
        "Testes de UI/estado, troca de contexto e retomada de rede",
        "Preservar contrato/cliente gerado; wrapper com origem/hash verificados; JDK/AGP/SDK compatíveis"
      ],
      "verification_commands": [
        [
          "bash",
          "apps/android/gradlew",
          "-p",
          "apps/android",
          "test",
          "lint",
          "assembleDebug"
        ]
      ],
      "risk": "medium",
      "max_retries": 1,
      "timeout_seconds": 2400,
      "approved": true
    },
    {
      "id": "T05-e2e",
      "spec": "specs/001-request-draft/spec.md",
      "description": "Provar integração, autorização cruzada e CI real das três plataformas",
      "role": "integration",
      "agent": "codex",
      "dependencies": [
        "T02-api",
        "T03-web",
        "T04-android"
      ],
      "allowed_paths": [
        "tests/e2e/",
        "scripts/verify-product.py",
        "Makefile",
        ".github/workflows/"
      ],
      "expected_outputs": [
        "tests/e2e/request-flow.spec.ts",
        ".github/workflows/verify.yml"
      ],
      "acceptance_criteria": [
        "AC-01 a AC-08; sem trocar API/DB por mocks na evidência ponta a ponta",
        "Corrigir comando Android de verificação para execução a partir da raiz; SDK ausente falha",
        "make verify agrega gates reais Web/API/Android/contratos/security; instrumentação explícita"
      ],
      "verification_commands": [
        [
          "make",
          "verify"
        ]
      ],
      "risk": "high",
      "max_retries": 1,
      "timeout_seconds": 3600,
      "approved": true
    }
  ]
}
