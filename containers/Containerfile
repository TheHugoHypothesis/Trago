ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv git make \
       openjdk-17-jdk-headless ca-certificates curl unzip libstdc++6 libgcc-s1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /cache /home/node/.cache /opt/agents /opt/pi /opt/android-sdk \
    && chown -R node:node /cache /home/node /opt/agents /opt/pi /opt/android-sdk
COPY pi /usr/local/bin/pi
RUN chmod 0755 /usr/local/bin/pi
ENV GRADLE_USER_HOME=/cache/gradle \
    NPM_CONFIG_CACHE=/cache/npm \
    XDG_CACHE_HOME=/cache \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=/opt/agents:/opt/android-sdk/platform-tools:/opt/android-sdk/cmdline-tools/latest/bin:$PATH
USER node
WORKDIR /workspace
CMD ["bash"]
